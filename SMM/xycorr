END {
    if (n == 0) {
        printf("Error in xycorr. Number of lines %i\n", n)
        exit
    }

    x0 /= n
    y0 /= n
    print "Mean x0 =", x0, "Mean y0 =", y0

    for (i = 1; i <= n; i++) {
        t += (x[i] - x0) * (y[i] - y0)
        nx += (x[i] - x0) * (x[i] - x0)
        ny += (y[i] - y0) * (y[i] - y0)
        print "Processing line", i, "t =", t, "nx =", nx, "ny =", ny
    }

    if (nx * ny == 0.0) {
        c = 0.0
    } else {
        c = t / sqrt(nx * ny)
    }

    printf("Pearson coefficient for N= %i data: %8.5f\n", n, c)
}
